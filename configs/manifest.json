{
  "manifest_version": 2,
  "name": "Firefox adds-on",
  "version": "1.0",
  "description": "Scaffolded firefox adds-on",
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "<path-to-icon>",
    "default_title": "Firefox adds-on",
    "default_popup": "menu/menu.html"
  },
  "icons": {
    "48": "<path-to-icon>"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["injection-script.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["activeTab"]
}
